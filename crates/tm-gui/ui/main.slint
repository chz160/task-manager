import { Button, CheckBox, ComboBox, StandardTableView, TabWidget, Palette } from "std-widgets.slint";

export struct GraphData {
    label: string,
    commands: string,
}

// Dark grid with a filled history line, in the style of the Windows 7 Performance tab.
component Graph inherits Rectangle {
    in property <string> commands;
    in property <color> line: #3fdc5a;
    background: #0b1a0b;
    border-width: 1px;
    border-color: #3a5a3a;
    for i in 3: Rectangle {
        y: parent.height * (i + 1) / 4;
        height: 1px;
        background: #1e3a1e;
    }
    Path {
        width: 100%;
        height: 100%;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: root.commands;
        fill: root.line.with-alpha(0.25);
        stroke: root.line;
        stroke-width: 1px;
    }
}

component LabeledGraph inherits VerticalLayout {
    in property <string> title;
    in property <string> value;
    in property <string> commands;
    in property <color> line: #3fdc5a;
    spacing: 4px;
    Text {
        text: root.title + "  " + root.value;
        font-weight: 600;
    }
    Graph {
        commands: root.commands;
        line: root.line;
    }
}

export component MainWindow inherits Window {
    title: "Task Manager";
    preferred-width: 980px;
    preferred-height: 560px;
    min-width: 520px;
    min-height: 380px;

    in property <[[StandardListViewItem]]> process-rows;
    in property <[[StandardListViewItem]]> detail-rows;
    in property <[[StandardListViewItem]]> startup-rows;
    in-out property <int> startup-selected-row: -1;
    in property <string> startup-action: "Disable";
    in property <[[StandardListViewItem]]> service-rows;
    in property <string> services-message;
    in property <[[StandardListViewItem]]> user-rows;
    in-out property <int> selected-row: -1;
    in-out property <int> detail-selected-row: -1;
    in-out property <int> current-tab: 0;

    in property <string> cpu-text;
    in property <string> cpu-commands;
    in property <string> mem-text;
    in property <string> mem-commands;
    in property <[GraphData]> cores;
    in property <string> stats-text;
    in property <string> status-text;

    // Set by Rust: non-empty text shows the message box; `confirming` picks the Yes/No form.
    in-out property <string> message;
    in-out property <bool> confirming;

    // The first argument says which process table: 0 = Processes, 1 = Details.
    callback sort-ascending(int, int);
    callback sort-descending(int, int);
    callback row-selected(int, int);
    callback tab-selected(int);
    callback startup-row-selected(int);
    callback startup-toggled();
    callback services-ready();
    callback service-sorted(int, bool);
    callback group-toggled(bool);
    callback end-process-clicked(int);
    callback end-process-confirmed();
    callback message-dismissed();
    callback interval-selected(int);

    VerticalLayout {
        padding: 8px;
        spacing: 8px;

        TabWidget {
            current-index <=> root.current-tab;
            changed current-index => { root.tab-selected(self.current-index); }
            Tab {
                title: "Processes";
                VerticalLayout {
                    spacing: 8px;
                    StandardTableView {
                        columns: [
                            { title: "Image Name", min-width: 140px, horizontal-stretch: 1 },
                            { title: "PID", min-width: 70px },
                            { title: "User Name", min-width: 120px },
                            { title: "CPU %", min-width: 90px },
                            { title: "Memory", min-width: 100px },
                            { title: "RSS", min-width: 100px },
                            { title: "Disk", min-width: 90px },
                            { title: "GPU", min-width: 60px },
                            { title: "Threads", min-width: 80px },
                        ];
                        rows: root.process-rows;
                        current-row <=> root.selected-row;
                        sort-ascending(c) => { root.sort-ascending(0, c); }
                        sort-descending(c) => { root.sort-descending(0, c); }
                        current-row-changed(r) => { root.row-selected(0, r); }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        CheckBox {
                            text: "Group by application";
                            checked: true;
                            toggled => { root.group-toggled(self.checked); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Button {
                            text: "End Process";
                            enabled: root.selected-row >= 0;
                            clicked => { root.end-process-clicked(0); }
                        }
                    }
                }
            }
            Tab {
                title: "Performance";
                VerticalLayout {
                    spacing: 10px;
                    LabeledGraph {
                        title: "CPU Usage";
                        value: root.cpu-text;
                        commands: root.cpu-commands;
                        vertical-stretch: 2;
                    }
                    LabeledGraph {
                        title: "Physical Memory";
                        value: root.mem-text;
                        commands: root.mem-commands;
                        line: #4aa3ff;
                        vertical-stretch: 2;
                    }
                    GridLayout {
                        spacing: 6px;
                        vertical-stretch: 2;
                        for core[i] in root.cores: LabeledGraph {
                            row: floor(i / 4);
                            col: mod(i, 4);
                            title: core.label;
                            commands: core.commands;
                            line: #e0c040;
                        }
                    }
                    Text {
                        text: root.stats-text;
                        wrap: word-wrap;
                    }
                }
            }
            Tab {
                title: "Startup";
                VerticalLayout {
                    spacing: 8px;
                    StandardTableView {
                        columns: [
                            { title: "Name", min-width: 160px },
                            { title: "Command", min-width: 280px, horizontal-stretch: 1 },
                            { title: "Status", min-width: 90px },
                            { title: "Location", min-width: 80px },
                        ];
                        rows: root.startup-rows;
                        current-row <=> root.startup-selected-row;
                        current-row-changed(r) => { root.startup-row-selected(r); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: root.startup-action;
                            enabled: root.startup-selected-row >= 0;
                            clicked => { root.startup-toggled(); }
                        }
                    }
                }
            }
            Tab {
                title: "Users";
                VerticalLayout {
                    StandardTableView {
                        columns: [
                            { title: "User Name", min-width: 140px, horizontal-stretch: 1 },
                            { title: "Processes", min-width: 100px },
                            { title: "CPU %", min-width: 90px },
                            { title: "Memory (RSS)", min-width: 130px },
                        ];
                        rows: root.user-rows;
                    }
                }
            }
            Tab {
                title: "Details";
                VerticalLayout {
                    spacing: 8px;
                    StandardTableView {
                        columns: [
                            { title: "Name", min-width: 130px },
                            { title: "PID", min-width: 70px },
                            { title: "Status", min-width: 90px },
                            { title: "User Name", min-width: 100px },
                            { title: "CPU %", min-width: 70px },
                            { title: "Memory", min-width: 100px },
                            { title: "Disk", min-width: 90px },
                            { title: "GPU", min-width: 60px },
                            { title: "Threads", min-width: 80px },
                            { title: "Command line", min-width: 300px, horizontal-stretch: 1 },
                        ];
                        rows: root.detail-rows;
                        current-row <=> root.detail-selected-row;
                        sort-ascending(c) => { root.sort-ascending(1, c); }
                        sort-descending(c) => { root.sort-descending(1, c); }
                        current-row-changed(r) => { root.row-selected(1, r); }
                    }
                    HorizontalLayout {
                        alignment: end;
                        Button {
                            text: "End Process";
                            enabled: root.detail-selected-row >= 0;
                            clicked => { root.end-process-clicked(1); }
                        }
                    }
                }
            }
            Tab {
                title: "Services";
                VerticalLayout {
                    spacing: 8px;
                    if root.services-message != "" : Text {
                        text: root.services-message;
                        wrap: word-wrap;
                    }
                    StandardTableView {
                        columns: [
                            { title: "Name", min-width: 160px },
                            { title: "PID", min-width: 70px },
                            { title: "Description", min-width: 300px, horizontal-stretch: 1 },
                            { title: "Status", min-width: 90px },
                        ];
                        rows: root.service-rows;
                        sort-ascending(c) => { root.service-sorted(c, true); }
                        sort-descending(c) => { root.service-sorted(c, false); }
                    }
                }
            }
        }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.status-text;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: "Refresh:";
                vertical-alignment: center;
            }
            ComboBox {
                model: ["1 s", "2 s", "5 s", "10 s"];
                current-index: 0;
                selected(_) => { root.interval-selected(self.current-index); }
            }
        }
    }

    if root.message != "" : Rectangle {
        background: #00000088;
        TouchArea { }
        Rectangle {
            width: min(parent.width - 32px, 420px);
            height: dialog.preferred-height + 32px;
            background: Palette.background;
            border-color: Palette.border;
            border-width: 1px;
            border-radius: 6px;
            dialog := VerticalLayout {
                padding: 16px;
                spacing: 16px;
                Text {
                    text: root.message;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    if root.confirming : Button {
                        text: "End process";
                        primary: true;
                        clicked => { root.end-process-confirmed(); }
                    }
                    Button {
                        text: root.confirming ? "Cancel" : "OK";
                        clicked => { root.message-dismissed(); }
                    }
                }
            }
        }
    }
}
